<Project>

  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <VersionPrefix>0.1.3</VersionPrefix>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    The SDK maps source paths to a neutral root only on CI, so a local pack would embed the local repository path in the
    assemblies, the symbols and the SourceLink data. Map it in every build: DeterministicSourcePaths covers the paths that
    come from source control and PathMap covers the repository folder when there is no source control information.
  -->
  <PropertyGroup>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory.Replace(',', ',,').Replace('=', '=='))=/_/</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>mahach666</Authors>
    <Copyright>Copyright (c) 2026 mahach666</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/IOExtend/PclIO</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IOExtend/PclIO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pointcloud;lidar;laser-scanning;e57;rcs;rcp;lgsx;fls;srf;smf;c3db;las;pts;xyz;reader</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(MSBuildProjectName)' != 'PclIO.Tests'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Report known-vulnerable packages, direct and transitive, as warnings (NU1901-NU1904). -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
