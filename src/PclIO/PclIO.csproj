<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Reads and converts point cloud files in several scanner and project formats (.e57, .rcs/.rcp, .lgsx/.lgs, .fls, .srf/.smf, .c3db/.c3ptx) and exports LAS, XYZ, PTS and JSON. Managed code with no dependencies on other packages.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PclIO</RootNamespace>
    <AssemblyName>PclIO</AssemblyName>
    <PackageId>PclIO</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PclIO.Tests" />
  </ItemGroup>

</Project>
